{
  "name": "@jessestricker/extra-projen",
  "description": "More projects and components for projen.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessestricker/extra-projen.git"
  },
  "scripts": {
    "api-extractor": "projen api-extractor",
    "build": "projen build",
    "bump": "projen bump",
    "clobber": "projen clobber",
    "compile": "projen compile",
    "default": "projen default",
    "eject": "projen eject",
    "eslint": "projen eslint",
    "package": "projen package",
    "post-compile": "projen post-compile",
    "post-upgrade": "projen post-upgrade",
    "pre-compile": "projen pre-compile",
    "prettier": "projen prettier",
    "release": "projen release",
    "test": "projen test",
    "test:watch": "projen test:watch",
    "unbump": "projen unbump",
    "upgrade": "projen upgrade",
    "watch": "projen watch",
    "projen": "projen"
  },
  "author": {
    "name": "Jesse Stricker",
    "email": "git@jessestricker.de",
    "organization": false
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@microsoft/api-extractor": "^7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "commit-and-tag-version": "^12",
    "constructs": "10.0.0",
    "eslint": "^10",
    "jest": "^30.4.2",
    "jest-junit": "^17",
    "prettier": "^3.9.1",
    "projen": "0.99.57",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  },
  "peerDependencies": {
    "constructs": "^10",
    "projen": ">=0.99.57 <1.0.0"
  },
  "dependencies": {
    "@dprint/formatter": "^0.5.1",
    "@dprint/typescript": "^0.96.1",
    "type-fest": "^5.7.0"
  },
  "pnpm": {},
  "keywords": [
    "projen"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10",
      "onFail": "ignore"
    }
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)",
      "<rootDir>/@(projenrc)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(projenrc)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    }
  },
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./typescript": "./lib/typescript/index.js",
    "./javascript": "./lib/javascript/index.js"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
